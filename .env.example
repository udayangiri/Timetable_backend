# ─────────────────────────────────────────────
# Smart Timetable Scheduler — Environment Config
# ─────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# JWT secret — MUST be at least 32 random characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server will refuse to start if this is missing or too short
JWT_SECRET=replace_with_output_of_command_above
